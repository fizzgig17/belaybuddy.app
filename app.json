{
  "expo": {
    "name": "Belay Buddy",
    "slug": "belay-buddy",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon-a.png",
    "scheme": "belaybuddy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/icons/icon-a.png",
      "bundleIdentifier": "app.belaybuddy.ios",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Belay Buddy uses the camera to photograph gym walls so Route AI can highlight the holds on a route.",
        "NSPhotoLibraryUsageDescription": "Belay Buddy lets you pick wall photos from your library for Route AI.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.belaybuddy.android",
      "adaptiveIcon": {
        "backgroundColor": "#0E7A80",
        "foregroundImage": "./assets/icons/android-a-foreground.png",
        "monochromeImage": "./assets/icons/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://belaybuddy.app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F2A2E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Belay Buddy uses your location to find nearby climbing gyms, outdoor crags, and climbing partners."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Belay Buddy uses Face ID to unlock the app when you've turned that on."
        }
      ],
      [
        "expo-notifications",
        {
          "mode": "production"
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "IconB",
            "ios": "./assets/icons/icon-b.png",
            "android": {
              "foregroundImage": "./assets/icons/android-b-foreground.png",
              "backgroundColor": "#E8EEEC"
            }
          },
          {
            "name": "IconC",
            "ios": "./assets/icons/icon-c.png",
            "android": {
              "foregroundImage": "./assets/icons/android-c-foreground.png",
              "backgroundColor": "#1B2B33"
            }
          }
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
