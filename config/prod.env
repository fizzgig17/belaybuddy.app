# Supabase connection for the PROD project (belaybuddy-prod).
# Public values, like .env. Expo never loads this file on its own (it only
# reads .env* files in the project root), so dev builds can't pick it up by
# accident. Production builds from master load it explicitly, e.g.:
#   set -a; . config/prod.env; set +a; npx expo export --clear ...
# --clear matters: Metro caches the inlined EXPO_PUBLIC_* values, so without
# it a prod build can silently reuse the dev values from an earlier build.
EXPO_PUBLIC_SUPABASE_URL=https://jcdyppjnmszkvtcwcyiq.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_WaauJ8OjgVon5qaQ3VTV4Q_YtcOsD83
EXPO_PUBLIC_APP_ENV=prod
